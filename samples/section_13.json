                    "textAlign": "left",
                    "textMode": "auto-height",
                    "_placeholder": true
                  },
                  {
                    "type": "TEXT",
                    "id": "177:9612",
                    "name": "滑环，就是负责为旋转体连通、输送能源与信号的电气部件。根据传输介质来区分，滑环分为电滑环、流体滑环、光滑环。滑环通常安装在设备的旋转中心，主要由旋转与静止两大部分组成。旋转部分连接设备的旋转结构并随之旋转运动，称为“转子”，静止部分连接设备的固定结构的能源，称为“定子”。",
                    "layoutStyle": {
                      "width": 847,
                      "height": 51,
                      "relativeX": 311,
                      "relativeY": 13
                    },
                    "fill": "paint_86:5202",
                    "_color": "#FFFFFF",
                    "_token": "Q-背景白",
                    "text": [
                      {
                        "text": "T13|177:9612",
                        "font": "font_86:5012"
                      }
                    ],
                    "textColor": [
                      {
                        "start": 0,
                        "end": 136,
                        "color": "paint_86:5202"
                      }
                    ],
                    "textAlign": "left",
                    "textMode": "auto-height",
                    "_placeholder": true
                  }
                ]
              }
            ]
